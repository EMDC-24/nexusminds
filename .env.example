# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it holds secrets.

# Resend API key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address (must belong to a domain you've verified in Resend)
# Until your own domain is verified you can use Resend's test sender:
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where every contact-form submission is delivered
CONTACT_TO_EMAIL=info@nexusmindstech.com
